# Job Agent Configuration
# Copy to .env and customize

# Environment
ENVIRONMENT=development
APP_VERSION=0.1.0

# Database
# DATABASE_URL=sqlite:////Users/user/Library/Application Support/job-agent/job_agent.db

# Browser automation
BROWSER_TYPE=chromium
HEADLESS=false  # Must be false to handle MFA/CAPTCHA
BROWSER_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Rate limiting & pacing
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=5.0
SEARCH_BATCH_DELAY=2.0
APPLICATION_DELAY=3.0
EMAIL_RATE_LIMIT=5

# Automation thresholds
CLEAN_SUBMISSIONS_THRESHOLD=3
DAILY_SEARCH_LIMIT=100
DAILY_APPLY_LIMIT=10
DAILY_MESSAGE_LIMIT=5

# Pre-submission analysis
# The analyst reads the finished application — resume, letter, answers,
# attachments — before anything is sent, and blocks on what is wrong with it.
ANALYST_ENABLED=true
ANALYST_MIN_ATS_SCORE=55   # Out of 100; below this no ATS parses the resume
ANALYST_MIN_FIT_SCORE=25   # % of the posting's requirements the resume evidences

# Job matching
FIT_SCORE_THRESHOLD=0.6
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Anthropic API (optional for better fit scoring)
# ANTHROPIC_API_KEY=sk-...
USE_ANTHROPIC=false

# Email
MAIL_APP_ENABLED=true
IMAP_SMTP_ENABLED=true
MAIL_SEND_DELAY=5.0

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_RELOAD=false

# Logging
LOG_LEVEL=INFO
# LOG_FILE=/path/to/job-agent.log
